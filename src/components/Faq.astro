---
/** FAQ accordion. Answers are HTML strings so they can contain links and emphasis. */
export interface FaqItem {
  q: string;
  a: string;
}
interface Props {
  items: FaqItem[];
  id?: string;
  heading?: string;
}
const { items, id = 'faq', heading = 'Frequently asked questions' } = Astro.props;
---

<h2 id={id}>{heading}</h2>
<div class="faq">
  {
    items.map((f) => (
      <details>
        <summary>{f.q}</summary>
        <div class="answer">
          <Fragment set:html={f.a} />
        </div>
      </details>
    ))
  }
</div>
