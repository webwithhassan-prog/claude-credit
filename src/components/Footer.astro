---
import Logo from './Logo.astro';
import { categories } from '../data/categories';
import { shortTitle, tools } from '../data/tools';
import { site } from '../site.config';

const popular = tools.filter((t) => t.featured);

const year = new Date().getFullYear();
const range = year > site.since ? `${site.since}–${year}` : `${year}`;
---

<footer class="site-footer">
  <div class="container">
    <div class="footer-grid">
      <div>
        <a class="brand" href="/">
          <Logo size={26} />
          <span>{site.name}</span>
        </a>
        <p style="margin-top:10px;max-width:340px">{site.tagline}</p>
      </div>
      <div>
        <h2>Calculators</h2>
        <ul>
          {
            categories.map((c) => (
              <li>
                <a href={`/${c.id}/`}>{c.name}</a>
              </li>
            ))
          }
          <li><a href="/calculators/">All calculators</a></li>
        </ul>
      </div>
      <div>
        <h2>Popular calculators</h2>
        <ul>
          {
            popular.map((t) => (
              <li>
                <a href={`/${t.slug}/`}>{shortTitle(t).replace(/ Calculator\b/, '')}</a>
              </li>
            ))
          }
        </ul>
      </div>
      <div>
        <h2>Resources</h2>
        <ul>
          <li><a href="/guides/">Guides</a></li>
          <li><a href="/glossary/">Glossary</a></li>
          <li><a href="/about/">About us</a></li>
          <li><a href="/editorial-policy/">Editorial policy</a></li>
          <li><a href="/methodology/">Methodology</a></li>
          <li><a href="/contact/">Contact</a></li>
          <li><a href="/sitemap/">Site map</a></li>
        </ul>
      </div>
      <div>
        <h2>Legal</h2>
        <ul>
          <li><a href="/privacy-policy/">Privacy policy</a></li>
          <li><a href="/cookie-policy/">Cookie policy</a></li>
          <li><a href="/terms/">Terms of use</a></li>
          <li><a href="/disclaimer/">Disclaimer</a></li>
        </ul>
      </div>
    </div>
    <p class="footer-disclaimer">
      {site.name} provides calculators and educational content for general information only. Results are estimates
      based on the figures you enter and the assumptions described on each page. They are not financial, tax, legal or
      insurance advice. Consult a qualified professional before making decisions.
    </p>
    <div class="footer-bottom">
      <span>© {range} {site.owner}. All rights reserved.</span>
      <span>Calculations run in your browser — the numbers you enter are never sent to our servers.</span>
    </div>
  </div>
</footer>
