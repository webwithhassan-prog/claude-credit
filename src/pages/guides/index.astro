---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import GuideCard from '../../components/GuideCard.astro';
import { site } from '../../site.config';

const guides = (await getCollection('guides')).sort((a, b) => b.data.updated.localeCompare(a.data.updated));
---

<BaseLayout
  title="Guides: Debt, Home Equity, Business Financing, Taxes & Benefits"
  description={`In-depth, sourced guides from ${site.name} that explain the rules behind our calculators — from the 2026 ACA subsidy cliff to factor rates and IRMAA appeals.`}
  path="/guides/"
>
  <div class="container">
    <Breadcrumbs items={[{ name: 'Home', href: '/' }, { name: 'Guides', href: '/guides/' }]} />
    <header class="page-hero">
      <h1>Guides</h1>
      <p class="lede">
        Plain-English explanations of the rules behind our calculators, with worked examples, checklists and links to official
        sources.
      </p>
    </header>
    <div class="guide-list" style="margin-top:10px">
      {guides.map((g) => <GuideCard entry={g} />)}
    </div>
  </div>
</BaseLayout>
