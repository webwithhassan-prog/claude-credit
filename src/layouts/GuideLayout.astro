---
import BaseLayout from './BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import AdSlot from '../components/AdSlot.astro';
import Icon from '../components/Icon.astro';
import { categoryById } from '../data/categories';
import { toolBySlug } from '../data/tools';
import { site } from '../site.config';

interface Props {
  slug: string;
  title: string;
  description: string;
  category: string;
  related: string[];
  published: string;
  updated: string;
  headings: { depth: number; slug: string; text: string }[];
  minutes: number;
}
const { slug, title, description, category, related, published, updated, headings, minutes } = Astro.props;
const cat = categoryById(category);
const path = `/guides/${slug}/`;
const url = `${site.url}${path}`;
const relatedTools = related.map(toolBySlug);
const primary = relatedTools[0];
const fmt = (d: string) =>
  new Date(`${d}T12:00:00Z`).toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric', timeZone: 'UTC' });
const toc = headings.filter((h) => h.depth === 2);

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Article',
    headline: title,
    description,
    datePublished: published,
    dateModified: updated,
    mainEntityOfPage: url,
    image: `${site.url}/og-image.png`,
    author: { '@type': 'Organization', name: `${site.name} editorial team`, url: `${site.url}/about/` },
    publisher: { '@id': `${site.url}/#organization` },
    inLanguage: 'en-US',
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: `${site.url}/` },
      { '@type': 'ListItem', position: 2, name: 'Guides', item: `${site.url}/guides/` },
      { '@type': 'ListItem', position: 3, name: title, item: url },
    ],
  },
];
---

<BaseLayout title={title} description={description} path={path} jsonLd={jsonLd} ogType="article">
  <div class="container">
    <Breadcrumbs items={[{ name: 'Home', href: '/' }, { name: 'Guides', href: '/guides/' }, { name: title, href: path }]} />
    <header class="page-hero">
      <a class="pill" href={`/${cat.id}/`} style="text-decoration:none">{cat.name}</a>
      <h1 style="margin-top:12px">{title}</h1>
      <p class="lede">{description}</p>
      <div class="meta-line">
        <span><Icon name="calendar" size={15} />Updated <time datetime={updated}>{fmt(updated)}</time></span>
        <span><Icon name="clock" size={15} />{minutes} min read</span>
        <span><Icon name="user" size={15} />By the <a href="/about/">{site.name} editorial team</a></span>
      </div>
    </header>

    <div class="tool-layout" style="margin-top:12px">
      <article class="prose">
        {
          toc.length > 2 && (
            <nav class="toc" aria-label="On this page">
              <strong>In this guide</strong>
              <ol>
                {toc.map((h) => (
                  <li>
                    <a href={`#${h.slug}`}>{h.text}</a>
                  </li>
                ))}
              </ol>
            </nav>
          )
        }
        {
          primary && (
            <a class="cta-card" href={`/${primary.slug}/`}>
              <span class="ico">
                <Icon name={primary.icon} />
              </span>
              <span>
                <strong>Run your own numbers</strong>
                <span>{primary.title} — {primary.short}</span>
              </span>
              <Icon name="arrow-right" />
            </a>
          )
        }
        <slot />
        <AdSlot slot="endOfContent" />
        <div class="author-box">
          <div class="avatar"><Icon name="book" /></div>
          <div>
            <strong>About this guide.</strong> Written by the {site.name} editorial team, first published {fmt(published)} and
            last reviewed {fmt(updated)}. It is general education, not financial, tax or legal advice. See our
            <a href="/editorial-policy/">editorial policy</a> or <a href="/contact/">report an error</a>.
          </div>
        </div>
      </article>
      <aside class="sidebar">
        <div class="sidebar-sticky">
          <section class="side-card">
            <h2>Related calculators</h2>
            <ul class="side-links">
              {
                relatedTools.map((t) => (
                  <li>
                    <a href={`/${t.slug}/`}>
                      <span class="ico">
                        <Icon name={t.icon} />
                      </span>
                      {t.title}
                    </a>
                  </li>
                ))
              }
            </ul>
          </section>
          <AdSlot slot="sidebar" variant="sidebar" />
        </div>
      </aside>
    </div>
  </div>
</BaseLayout>
