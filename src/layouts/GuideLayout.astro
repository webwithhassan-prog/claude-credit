---
import BaseLayout from './BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import AdSlot from '../components/AdSlot.astro';
import Icon from '../components/Icon.astro';
import GuideCard from '../components/GuideCard.astro';
import { getCollection } from 'astro:content';
import { categoryById } from '../data/categories';
import { toolBySlug } from '../data/tools';
import { termsForGuide } from '../data/glossary';
import { site } from '../site.config';
import { abs, authorRef, breadcrumbNode, ids, ogImageUrl, webPageNode } from '../lib/seo';

interface Props {
  slug: string;
  title: string;
  /** Shorter <title> for search results; the H1 keeps the full title. */
  seoTitle?: string;
  description: string;
  category: string;
  related: string[];
  published: string;
  updated: string;
  headings: { depth: number; slug: string; text: string }[];
  minutes: number;
}
const { slug, title, seoTitle, description, category, related, published, updated, headings, minutes } = Astro.props;
const cat = categoryById(category);
const path = `/guides/${slug}/`;
const relatedTools = related.map(toolBySlug);
const primary = relatedTools[0];
const fmt = (d: string) =>
  new Date(`${d}T12:00:00Z`).toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric', timeZone: 'UTC' });
const toc = headings.filter((h) => h.depth === 2);
const terms = termsForGuide(slug);
// Other guides on the same topic or about the same calculators, strongest overlap first.
const relatedGuides = (await getCollection('guides'))
  .filter((g) => g.id !== slug)
  .map((g) => ({ g, score: (g.data.category === category ? 2 : 0) + g.data.related.filter((r) => related.includes(r)).length }))
  .filter((x) => x.score > 0)
  .sort((a, b) => b.score - a.score || a.g.data.title.localeCompare(b.g.data.title))
  .slice(0, 4)
  .map((x) => x.g);

const jsonLd = [
  webPageNode({
    path,
    name: seoTitle ?? title,
    description,
    datePublished: published,
    dateModified: updated,
    reviewed: true,
    mainEntity: ids.main(path),
  }),
  {
    '@type': 'Article',
    '@id': ids.main(path),
    headline: title,
    description,
    datePublished: published,
    dateModified: updated,
    mainEntityOfPage: { '@id': ids.page(path) },
    image: ogImageUrl(path),
    articleSection: cat.name,
    author: authorRef(),
    publisher: { '@id': ids.organization },
    inLanguage: 'en-US',
    about: relatedTools.map((t) => ({ '@type': 'Thing', name: t.title, url: abs(`/${t.slug}/`) })),
  },
  breadcrumbNode(path, [
    { name: 'Home', path: '/' },
    { name: 'Guides', path: '/guides/' },
    { name: title, path },
  ]),
];
---

<BaseLayout title={seoTitle ?? title} description={description} path={path} jsonLd={jsonLd} ogType="article" published={published} modified={updated}>
  <div class="container">
    <Breadcrumbs items={[{ name: 'Home', href: '/' }, { name: 'Guides', href: '/guides/' }, { name: title, href: path }]} />
    <header class="page-hero">
      <a class="pill" href={`/${cat.id}/`} style="text-decoration:none">{cat.name}</a>
      <h1 style="margin-top:12px">{title}</h1>
      <p class="lede">{description}</p>
      <div class="meta-line">
        <span><Icon name="calendar" size={15} />Updated <time datetime={updated}>{fmt(updated)}</time></span>
        <span><Icon name="clock" size={15} />{minutes} min read</span>
        {
          site.author.name ? (
            <span><Icon name="user" size={15} />By <a href="/about/#team">{site.author.name}</a></span>
          ) : (
            <span><Icon name="user" size={15} />By the <a href="/about/">{site.name} editorial team</a></span>
          )
        }
        {
          site.reviewer.name && (
            <span><Icon name="shield" size={15} />Reviewed by <a href="/about/#team">{site.reviewer.name}</a>{site.reviewer.jobTitle && `, ${site.reviewer.jobTitle}`}</span>
          )
        }
      </div>
    </header>

    <div class="tool-layout" style="margin-top:12px">
      <article class="prose">
        {
          toc.length > 2 && (
            <nav class="toc" aria-label="On this page">
              <strong>In this guide</strong>
              <ol>
                {toc.map((h) => (
                  <li>
                    <a href={`#${h.slug}`}>{h.text}</a>
                  </li>
                ))}
              </ol>
            </nav>
          )
        }
        {
          primary && (
            <a class="cta-card" href={`/${primary.slug}/`}>
              <span class="ico">
                <Icon name={primary.icon} />
              </span>
              <span>
                <strong>Run your own numbers</strong>
                <span>{primary.title} — {primary.short}</span>
              </span>
              <Icon name="arrow-right" />
            </a>
          )
        }
        <slot />
        {
          terms.length > 0 && (
            <>
              <h2 id="key-terms">Key terms</h2>
              <ul class="term-chips">
                {terms.map((t) => (
                  <li>
                    <a href={`/glossary/#${t.id}`}>{t.term}</a>
                  </li>
                ))}
              </ul>
            </>
          )
        }
        {
          relatedGuides.length > 0 && (
            <>
              <h2 id="related-guides">Related guides</h2>
              <div class="guide-list related-guides">
                {relatedGuides.map((g) => (
                  <GuideCard entry={g} />
                ))}
              </div>
            </>
          )
        }
        <AdSlot unit="endOfContent" />
        <div class="author-box">
          <div class="avatar"><Icon name="book" /></div>
          <div>
            <strong>About this guide.</strong> Written by {site.author.name || `the ${site.name} editorial team`}{site.reviewer.name && `, reviewed by ${site.reviewer.name}${site.reviewer.jobTitle ? ` (${site.reviewer.jobTitle})` : ''}`}, first published {fmt(published)} and
            last reviewed {fmt(updated)}. It is general education, not financial, tax or legal advice. See our
            <a href="/editorial-policy/">editorial policy</a> or <a href="/contact/">report an error</a>.
          </div>
        </div>
      </article>
      <aside class="sidebar">
        <div class="sidebar-sticky">
          <section class="side-card">
            <h2>Related calculators</h2>
            <ul class="side-links">
              {
                relatedTools.map((t) => (
                  <li>
                    <a href={`/${t.slug}/`}>
                      <span class="ico">
                        <Icon name={t.icon} />
                      </span>
                      {t.title}
                    </a>
                  </li>
                ))
              }
            </ul>
          </section>
          <AdSlot unit="sidebar" variant="sidebar" />
        </div>
      </aside>
    </div>
  </div>
</BaseLayout>
